APP_NAME=WorkOS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=workos
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/github/callback

# Telegram notifications (create a bot with @BotFather)
TELEGRAM_BOT_TOKEN=
# Optional fallback chat ID that receives every notification.
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFICATIONS_ENABLED=true
# Comma-separated Telegram user IDs allowed to run two-way commands.
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_POLL_TIMEOUT=30

# Google Sheets OAuth (Google Cloud Console → APIs & Services → Credentials)
# Enable the Google Sheets API and add the callback URL above as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/google/callback

FRONTEND_URL=http://localhost:5173

VITE_APP_NAME="${APP_NAME}"

# Initial team accounts created by: php artisan db:seed
ADMIN_NAME="Super Admin"
ADMIN_EMAIL=admin@workos.com
ADMIN_PASSWORD=admin123
DEVELOPER_NAME="Developer"
DEVELOPER_EMAIL=developer@workos.com
# Leave blank to keep an existing developer password unchanged.
DEVELOPER_PASSWORD=
TESTER_NAME="Demo Tester"
TESTER_EMAIL=tester@workos.local
TESTER_ACCESS_KEY=tst_workos-demo-tester-2026

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Ollama (Ollama Cloud API key, or a local daemon at OLLAMA_BASE_URL like http://localhost:11434)
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:120b
# OLLAMA_BASE_URL=https://ollama.com

AI_PROVIDER=groq
